<Project Sdk="Microsoft.NET.Sdk">
  <!-- LocalHome for the Windows desktop: a small window and a tray icon, on
       the board's existing API. .NET Framework 4.8 and WebView2 both come with
       Windows 11, so the installer stays one small file. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalHome</AssemblyName>
    <RootNamespace>LocalHome.Desktop</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Product>LocalHome</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WebView2Version>1.0.4258.31</WebView2Version>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's page, served from inside the program. -->
    <EmbeddedResource Include="web\*" LogicalName="web/%(Filename)%(Extension)" />
    <!-- What the installer puts beside the program. -->
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="lib/Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="lib/Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="lib/WebView2Loader.dll" />
  </ItemGroup>

  <!-- The program alone, away from its libraries, is the installer. -->
  <Target Name="CopySetup" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="..\dist\LocalHome-Setup.exe" />
  </Target>
</Project>
